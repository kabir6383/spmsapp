EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Optional backend and hardware secrets
FIREBASE_DATABASE_SECRET=your-firebase-database-token
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
WIFI_NAME=your-wifi-name
WIFI_PASS=your-wifi-password

# Admin Testing Credentials (Login Screen)
EXPO_PUBLIC_ADMIN_TEST_EMAIL=admin@spms.com
EXPO_PUBLIC_ADMIN_TEST_PASSWORD=Admin@1234

